{
  "name": "pi-zotero-web",
  "version": "0.4.0",
  "description": "Zotero integration for pi: CRUD on items + PDFs, library search, tags & collections, citation export, full-text, duplicate detection on create, and /login key management. Talks to the Zotero Web API or the Local API of the running desktop app (auto-detected, `zotero.mode` setting to override).",
  "type": "module",
  "main": "./index.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "zotero"
  ],
  "author": "Luciano Joublanc (https://github.com/lJoublanc/pi-zotero-web)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lJoublanc/pi-zotero-web.git"
  },
  "homepage": "https://github.com/lJoublanc/pi-zotero-web",
  "bugs": {
    "url": "https://github.com/lJoublanc/pi-zotero-web/issues"
  },
  "scripts": {
    "test": "node --experimental-transform-types --test test/*.test.ts",
    "check": "node --experimental-transform-types --test test/*.test.ts",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=22.7"
  },
  "files": [
    "index.ts",
    "provider.ts",
    "client.ts",
    "localAuth.ts",
    "mode.ts",
    "tools.ts",
    "skills/",
    "README.md",
    "package.json"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills/"
    ]
  }
}